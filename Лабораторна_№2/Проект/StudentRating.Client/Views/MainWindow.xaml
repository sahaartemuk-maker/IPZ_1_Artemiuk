<Window x:Class="StudentRating.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Моніторинг рейтингу студентів" Width="900" Height="600"
        WindowStartupLocation="CenterScreen" Style="{StaticResource WindowStyle}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <DockPanel>
        <!-- Верхня панель: користувач і кнопки -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Про програму" Style="{StaticResource SecondaryButton}" Click="OnAboutClick"/>
                    <Button Content="Вийти" Style="{StaticResource SecondaryButton}" Click="OnLogoutClick"/>
                </StackPanel>
                <TextBlock Foreground="White" FontSize="15" VerticalAlignment="Center">
                    <Run Text="{Binding CurrentUser.FullName, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text=" — "/>
                    <Run Text="{Binding CurrentUser.RoleName, Mode=OneWay}"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Margin="12,4" Foreground="Gray"/>

        <TabControl Margin="8">
            <!-- 1. Рейтинг групи -->
            <TabItem Header="Рейтинг групи">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Text="Група:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="140" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"/>
                        <Button Content="Показати" Style="{StaticResource PrimaryButton}" Click="OnShowRatingClick"/>
                        <Button Content="Детально…" Style="{StaticResource PrimaryButton}" Click="OnDetailsClick"/>
                        <Button Content="Експорт у CSV" Style="{StaticResource SecondaryButton}" Click="OnExportClick"
                                Visibility="{Binding CurrentUser.IsTeacher, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <DataGrid x:Name="RatingGrid" Margin="0,8,0,0" ItemsSource="{Binding Rating}"
                              SelectedItem="{Binding SelectedStudent}" MouseDoubleClick="OnDetailsClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Місце" Binding="{Binding Place}" Width="70"/>
                            <DataGridTextColumn Header="ПІБ" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Група" Binding="{Binding Group}" Width="100"/>
                            <DataGridTextColumn Header="Курс" Binding="{Binding Course}" Width="70"/>
                            <DataGridTextColumn Header="Середній бал" Binding="{Binding AverageScore, StringFormat=F2}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 2. Пошук кращих -->
            <TabItem Header="Пошук кращих">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Left" Width="220" Margin="0,0,12,0" DataContext="{Binding Criteria}">
                        <TextBlock Text="Курс:" Style="{StaticResource LabelText}"/>
                        <ComboBox x:Name="CourseCombo" DisplayMemberPath="Name" SelectedValuePath="Value"
                                  SelectedValue="{Binding Course}"/>
                        <TextBlock Text="Група:" Style="{StaticResource LabelText}"/>
                        <ComboBox x:Name="GroupCombo" SelectedItem="{Binding Group}"/>
                        <TextBlock Text="Предмет:" Style="{StaticResource LabelText}"/>
                        <ComboBox x:Name="SubjectCombo" SelectedItem="{Binding Subject}"/>
                        <TextBlock Text="Мінімальний бал (0–100):" Style="{StaticResource LabelText}"/>
                        <TextBox Text="{Binding MinScore, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Кількість (топ-N):" Style="{StaticResource LabelText}"/>
                        <TextBox Text="{Binding TopCount, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Знайти" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Click="OnSearchClick"/>
                        <Button Content="Скинути" Style="{StaticResource SecondaryButton}" Margin="0,4,0,0" Click="OnResetClick"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding BestStudents}" MouseDoubleClick="OnBestDetailsClick" x:Name="BestGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Place}" Width="50"/>
                            <DataGridTextColumn Header="ПІБ" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Група" Binding="{Binding Group}" Width="100"/>
                            <DataGridTextColumn Header="Середній бал" Binding="{Binding AverageScore, StringFormat=F2}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 3. Оцінки (лише для викладача) -->
            <TabItem Header="Оцінки" Visibility="{Binding CurrentUser.IsTeacher, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Text="Оберіть студента в рейтингу групи та натисніть:" VerticalAlignment="Center"/>
                        <Button Content="Редагувати оцінки…" Style="{StaticResource PrimaryButton}" Click="OnEditGradesClick"/>
                    </StackPanel>
                    <Border Margin="0,8,0,0" Padding="12" Background="White" BorderBrush="#CCC" BorderThickness="1">
                        <StackPanel DataContext="{Binding SelectedStudent}">
                            <TextBlock Text="{Binding FullName}" Style="{StaticResource HeaderText}"/>
                            <TextBlock Text="{Binding Group, StringFormat='Група: {0}'}"/>
                            <TextBlock Text="{Binding AverageScore, StringFormat='Середній бал: {0:F2}'}"/>
                            <ItemsControl ItemsSource="{Binding Grades}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Subject, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding Score, Mode=OneWay}" FontWeight="Bold"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
