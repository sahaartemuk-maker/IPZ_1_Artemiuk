<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StudentRating.Client.Views.GradeEditDialog"
        Title="Редагування оцінок" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" Classes="header"/>
        <TextBlock Text="Двічі клацніть на бал, щоб змінити (0–100):" Classes="label"/>
        <DataGrid x:Name="GradesGrid" IsReadOnly="False" Height="230">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Предмет" Binding="{Binding Subject}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Бал" Binding="{Binding Score}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="StatusText" Classes="status"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Зберегти" Classes="primary" IsDefault="True" Click="OnSaveClick"/>
            <Button Content="Скасувати" Classes="secondary" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </StackPanel>
</Window>
