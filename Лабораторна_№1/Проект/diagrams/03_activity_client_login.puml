@startuml
title Діаграма активності клієнта — Авторизація
start
:Запуск програми;
:Відобразити вікно входу;
repeat
  :Ввести логін і пароль;
  if (Поля заповнені?) then (ні)
    :Показати повідомлення про помилку;
  else (так)
    :Сформувати пакет LOGIN;
    :Надіслати запит на сервер по TCP;
    if (Сервер доступний?) then (ні)
      :Повідомити про відсутність з'єднання;
    else (так)
      :Отримати відповідь;
    endif
  endif
repeat while (Авторизація успішна?) is (ні)
->так;
:Зберегти роль користувача;
:Відкрити головне вікно;
stop
@enduml
