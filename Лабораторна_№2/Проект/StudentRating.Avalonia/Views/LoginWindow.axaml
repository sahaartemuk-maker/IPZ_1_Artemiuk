<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StudentRating.Client.Views.LoginWindow"
        Title="Вхід — Рейтинг студентів" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" CanResize="False">
    <StackPanel Margin="24">
        <TextBlock Text="Моніторинг рейтингу студентів" Classes="header"/>

        <TextBlock Text="Логін:" Classes="label"/>
        <TextBox x:Name="LoginBox" Text="{Binding Login}"/>

        <TextBlock Text="Пароль:" Classes="label"/>
        <TextBox x:Name="PasswordBox" PasswordChar="●"/>

        <TextBlock x:Name="StatusText" Classes="status"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Увійти" Classes="primary" IsDefault="True" Click="OnLoginClick"/>
            <Button Content="Вихід" Classes="secondary" IsCancel="True" Click="OnExitClick"/>
        </StackPanel>
        <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                   Text="Демо: student/1111, teacher/2222, admin/admin"/>
    </StackPanel>
</Window>
