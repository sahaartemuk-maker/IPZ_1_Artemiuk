<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StudentRating.Client.Views.MessageWindow"
        Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="YesButton" Content="Так" Classes="primary" IsDefault="True" Click="OnYes"/>
            <Button x:Name="NoButton" Content="Ні" Classes="secondary" IsCancel="True" Click="OnNo"/>
        </StackPanel>
    </StackPanel>
</Window>
