<Window x:Class="StudentRating.Client.Views.StudentDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Картка студента" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Style="{StaticResource WindowStyle}">
    <StackPanel Margin="20">
        <TextBlock Text="{Binding FullName}" Style="{StaticResource HeaderText}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="Група:"/>                <TextBlock Grid.Column="1" Text="{Binding Group}"/>
            <TextBlock Grid.Row="1" Text="Курс:"/>     <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Course}"/>
            <TextBlock Grid.Row="2" Text="Місце:"/>    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Place}"/>
            <TextBlock Grid.Row="3" Text="Середній бал:"/>
            <TextBlock Grid.Row="3" Grid.Column="1" FontWeight="Bold" Text="{Binding AverageScore, StringFormat=F2}"/>
        </Grid>
        <TextBlock Text="Оцінки:" Style="{StaticResource LabelText}" FontWeight="Bold"/>
        <DataGrid ItemsSource="{Binding Grades}" Height="170">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Предмет" Binding="{Binding Subject}" Width="*"/>
                <DataGridTextColumn Header="Бал" Binding="{Binding Score}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="Закрити" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                Margin="0,12,0,0" IsCancel="True" IsDefault="True"/>
    </StackPanel>
</Window>
