@startuml
title Діаграма активності сервера — Збереження оцінок
start
:Отримати команду SAVE_GRADES;
if (Відправник має роль викладача?) then (ні)
  :Відповісти ACCESS_DENIED;
  stop
endif
:Почати транзакцію БД;
:Записати/оновити оцінки;
if (Помилка запису?) then (так)
  :Відкотити транзакцію;
  :Відповісти ERROR;
else (ні)
  :Підтвердити транзакцію;
  :Перерахувати рейтинг групи;
  :Відповісти OK;
endif
stop
@enduml
